[config]
# AmigaOS 3.1.4 on an A1200 with a 68030 and 8 MB Fast RAM: the ROM and
# the system drawer come from setup_os314.sh (your own ROM and disks)
amiga_model = A1200
cpu = 68030
fast_memory = 8192
kickstart_file = /tmp/claude-0/os314/kick.rom
hard_drive_0 = /tmp/claude-0/os314/sys
hard_drive_0_label = System
hard_drive_0_priority = 6
hard_drive_1 = /home/user/amibash/emu/dh0
hard_drive_1_label = Work
sound_card = none
floppy_drive_volume = 0
window_width = 1280
window_height = 1024
fullscreen = 0
automatic_input_grab = 0
initial_input_grab = 0
video_sync = 0
uae_cpu_speed = max
joystick_port_0 = mouse
joystick_port_1 = none
bsdsocket_library = 1
