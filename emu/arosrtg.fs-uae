[config]
# current AROS m68k (nightly ISO contents in /tmp/claude-0/arosfs) with an
# RTG card, for testing anti-aliased TrueType output
amiga_model = A4000/040
kickstart_file = /tmp/claude-0/arosfs/boot/amiga/aros-rom.bin
kickstart_ext_file = /tmp/claude-0/arosfs/boot/amiga/aros-ext.bin
hard_drive_0 = /tmp/claude-0/arosfs
hard_drive_0_label = AROS
hard_drive_1 = /home/user/amibash/emu/dh0
hard_drive_1_label = Work
zorro_iii_memory = 65536
graphics_card = uaegfx
graphics_memory = 16384
sound_card = none
floppy_drive_volume = 0
window_width = 1280
window_height = 1024
fullscreen = 0
automatic_input_grab = 0
initial_input_grab = 0
video_sync = 0
uae_cpu_speed = max
joystick_port_0 = mouse
joystick_port_1 = none
mouse_speed = 300
bsdsocket_library = 1
