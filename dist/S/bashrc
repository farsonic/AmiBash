# S:bashrc - system-wide AmiBash startup file (read by interactive shells
# before ~/.bashrc).  Copy to S: and edit to taste.

# Prompt: bold user@host, then the current directory (pen 3 = blue on the
# default Workbench palette).  \w shows ~ for $HOME.
PS1='\[\e[1m\]\u@\h\[\e[0m\]:\[\e[33m\]\w\[\e[0m\]\$ '

# Where "cd" with no arguments goes, and where history is kept.
# HOME=SYS:Home        # uncomment (and MakeDir SYS:Home) for a home directory
HISTSIZE=500
HISTCONTROL=ignoredups:ignorespace

# The Amiga file system is case-insensitive; match globs the same way.
shopt -s nocaseglob

# Colours: ls and grep colour their output on the console
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# Screen colours and console font (Amiga only), e.g.:
#   palette 0 102040; palette 1 ffff80; palette 3 ff8800   # dark theme
#   setfont topaz 9          # any fixed-width font in FONTS:

# Handy aliases
alias ll='ls -l'
alias la='ls -la'
alias l='ls -F'
alias ..='cd ..'
alias md='mkdir -p'
alias cls='clear'

# Run any AmigaDOS command line through the native shell, e.g.
#   ados 'list SYS: PAT=#?.info'
# (AmigaDOS commands in C: can also be run directly: List, Copy, Info ...)
