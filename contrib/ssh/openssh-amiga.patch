+/*
+ * The separator to put between a directory and a name in it: none after
+ * a '/', or after the ':' of an AmigaDOS volume or assign ("SYS:").
+ */
+const char *
+dir_sep(const char *dir)
+{
+	size_t len = strlen(dir);
+
+	if (len == 0)
+		return "/";
+	if (dir[len - 1] == '/')
+		return "";
+#ifdef __amigaos__
+	if (dir[len - 1] == ':')
+		return "";
+#endif
+	return "/";
+}
+
