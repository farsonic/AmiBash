+/*
+ * The size of a character cell in pixels: not known in a console.
+ */
+    void
+mch_calc_cell_size(struct cellsize *cs_out)
+{
+    cs_out->cs_xpixel = 0;
+    cs_out->cs_ypixel = 0;
+}
+
+/*
+ * system() and systemlist() with a List: there is no execvp(), so quote the
+ * arguments into one command line and run it as a string command would.
+ */
+    char_u *
+mch_get_cmd_output_direct(
+	char	**argv,
+	char_u	*infile,
+	int	flags,
+	int	*ret_len)
+{
+    garray_T	ga;
+    char_u	*res;
+    int		i;
+
+    ga_init2(&ga, 1, 200);
+    for (i = 0; argv[i] != NULL; ++i)
+    {
+	char *p;
+
+	if (i > 0)
+	    ga_append(&ga, ' ');
+	ga_append(&ga, '"');
+	for (p = argv[i]; *p != NUL; ++p)
+	{
+	    // "*" is the escape character of AmigaDOS ReadArgs()
+	    if (*p == '"' || *p == '*')
+		ga_append(&ga, '*');
+	    ga_append(&ga, *p);
+	}
+	ga_append(&ga, '"');
+    }
+    ga_append(&ga, NUL);
+    if (ga.ga_data == NULL)
+	return NULL;
+    res = get_cmd_output(ga.ga_data, infile, flags, ret_len);
+    ga_clear(&ga);
+    return res;
+}
