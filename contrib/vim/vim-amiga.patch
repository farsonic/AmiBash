+/*
+ * The size in $LINES and $COLUMNS, as a last resort.
+ * Return FAIL for failure, OK otherwise.
+ */
+    static int
+env_shellsize(void)
+{
+    char_u  *l = mch_getenv((char_u *)"LINES");
+    char_u  *c = mch_getenv((char_u *)"COLUMNS");
+    int	    r, n;
+
+    if (l == NULL || c == NULL)
+	return FAIL;
+    r = atoi((char *)l);
+    n = atoi((char *)c);
+    if (r <= 0 || n <= 0)
+	return FAIL;
+    Rows = r;
+    Columns = n;
+    return OK;
+}
+
+#if defined(__AROS__) || defined(__MORPHOS__)
+/*
+ * Get console size in a system friendly way on AROS and MorphOS.
+ * Return FAIL for failure, OK otherwise
+ */
+    int
+mch_get_shellsize(void)
+{
+    if (!term_console)
+	return env_shellsize();
+
+    if (bounds_report() == OK)
+	return OK;
 
     // I/O error. Default size fallback.
     term_console = FALSE;
+    if (env_shellsize() == OK)
+	return OK;
     Columns = 80;
     Rows = 24;
 
@@ -1137,14 +1197,17 @@ mch_get_shellsize(void)
     char	    id_a[sizeof(struct InfoData) + 3];
