+    if (!term_console && (raw_out == (BPTR)NULL || !IsInteractive(raw_out)))
+	return env_shellsize();
 
     // insure longword alignment
 # ifdef __amigaos4__
     if (!(id = AllocDosObject(DOS_INFODATA, 0)))
-	goto out;
+	return env_shellsize();
 # else
     id = (struct InfoData *)(((long)id_a + 3L) & ~3L);
 # endif
@@ -1154,7 +1217,7 @@ mch_get_shellsize(void)
